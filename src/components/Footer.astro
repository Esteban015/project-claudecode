---
import NewsletterForm from './NewsletterForm.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-secondary mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
      <div>
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-text-primary mb-3">
          <span class="text-accent-primary text-2xl">⬡</span>
          Mi Blog
        </a>
        <p class="text-text-muted text-sm leading-relaxed max-w-xs">
          Un espacio para compartir ideas sobre desarrollo web, tecnología y aprendizaje continuo.
        </p>
        <div class="flex gap-4 mt-4">
          <a href="/rss.xml" class="text-text-muted hover:text-accent-primary transition-colors text-sm flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
            RSS
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-text-primary mb-4">Newsletter</h3>
        <NewsletterForm />
      </div>
    </div>

    <div class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-text-muted">
      <p>© {year} Mi Blog. Hecho con <a href="https://astro.build" class="hover:text-accent-primary transition-colors">Astro</a>.</p>
      <nav class="flex gap-4">
        <a href="/blog" class="hover:text-text-primary transition-colors">Blog</a>
        <a href="/blog/archivo" class="hover:text-text-primary transition-colors">Archivo</a>
        <a href="/sitemap-index.xml" class="hover:text-text-primary transition-colors">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>
