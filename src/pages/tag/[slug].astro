---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getReadingTime, getAllTags } from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const tags = getAllTags(allPosts);

  return tags.map(({ name }) => ({
    params: { slug: name },
    props: {
      tag: name,
      posts: allPosts.filter((p) => p.data.tags.includes(name)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Artículos etiquetados con ${tag}.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10">
      <p class="text-text-muted text-sm mb-2">Etiqueta</p>
      <h1 class="text-3xl font-bold text-text-primary">#{tag}</h1>
      <p class="text-text-muted mt-1">{posts.length} artículo{posts.length !== 1 ? 's' : ''}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} readingTime={getReadingTime(post.body)} />
      ))}
    </div>
  </div>
</BaseLayout>
