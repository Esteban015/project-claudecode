---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto"
  description="¿Tienes una pregunta, sugerencia o quieres colaborar? Escríbenos y te respondemos a la brevedad."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 animate-fade-up">

    <!-- Hero -->
    <div class="mb-12">
      <p class="text-accent-primary font-semibold text-sm mb-2 uppercase tracking-wider">Contacto</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-text-primary leading-tight mb-4">
        Hablemos
      </h1>
      <p class="text-lg text-text-muted leading-relaxed">
        ¿Tienes una pregunta, quieres proponer un tema o simplemente pasar a saludar?
        Rellena el formulario y te respondemos lo antes posible.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Formulario -->
      <div class="md:col-span-2">
        <form id="contact-form" class="space-y-5" novalidate>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-sm font-medium text-text-primary mb-1.5">
                Nombre <span class="text-accent-primary">*</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                placeholder="Tu nombre"
                class="w-full px-4 py-2.5 bg-bg-secondary border border-border rounded-lg text-text-primary placeholder:text-text-muted text-sm focus:outline-none focus:border-accent-primary transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-text-primary mb-1.5">
                Email <span class="text-accent-primary">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full px-4 py-2.5 bg-bg-secondary border border-border rounded-lg text-text-primary placeholder:text-text-muted text-sm focus:outline-none focus:border-accent-primary transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="asunto" class="block text-sm font-medium text-text-primary mb-1.5">
              Asunto <span class="text-accent-primary">*</span>
            </label>
            <select
              id="asunto"
              name="asunto"
              required
              class="w-full px-4 py-2.5 bg-bg-secondary border border-border rounded-lg text-text-primary text-sm focus:outline-none focus:border-accent-primary transition-colors appearance-none cursor-pointer"
            >
              <option value="" disabled selected class="text-text-muted">Selecciona un asunto</option>
              <option value="pregunta">Tengo una pregunta</option>
              <option value="sugerencia">Sugerencia de tema</option>
              <option value="colaboracion">Quiero colaborar</option>
              <option value="error">Encontré un error</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-medium text-text-primary mb-1.5">
              Mensaje <span class="text-accent-primary">*</span>
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="5"
              placeholder="Cuéntanos en qué podemos ayudarte..."
              class="w-full px-4 py-2.5 bg-bg-secondary border border-border rounded-lg text-text-primary placeholder:text-text-muted text-sm focus:outline-none focus:border-accent-primary transition-colors resize-none"
            ></textarea>
            <p class="text-xs text-text-muted mt-1 text-right">
              <span id="char-count">0</span> / 500 caracteres
            </p>
          </div>

          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="privacidad"
              name="privacidad"
              required
              class="mt-0.5 w-4 h-4 accent-[#7C3AED] cursor-pointer"
            />
            <label for="privacidad" class="text-sm text-text-muted cursor-pointer leading-relaxed">
              He leído y acepto la política de privacidad. Mis datos serán usados únicamente para responder a este mensaje.
            </label>
          </div>

          <div>
            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-2.5 bg-accent-primary hover:bg-accent-hover text-white text-sm font-medium rounded-lg transition-colors"
            >
              Enviar mensaje
            </button>
          </div>

          <!-- Mensajes de estado -->
          <div id="form-success" class="hidden p-4 bg-green-500/10 border border-green-500/30 rounded-lg">
            <p class="text-green-400 text-sm font-medium">✓ ¡Mensaje enviado! Te responderemos pronto.</p>
          </div>
          <div id="form-error" class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-lg">
            <p id="form-error-text" class="text-red-400 text-sm"></p>
          </div>

        </form>
      </div>

      <!-- Info lateral -->
      <aside class="space-y-5">

        <div class="bg-bg-secondary border border-border rounded-xl p-5">
          <h3 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-4">Información</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-accent-primary mt-0.5">✉</span>
              <div>
                <p class="text-xs text-text-muted">Email</p>
                <p class="text-sm text-text-primary">hola@miblog.dev</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-primary mt-0.5">⏱</span>
              <div>
                <p class="text-xs text-text-muted">Tiempo de respuesta</p>
                <p class="text-sm text-text-primary">24 – 48 horas</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-primary mt-0.5">🌍</span>
              <div>
                <p class="text-xs text-text-muted">Idioma</p>
                <p class="text-sm text-text-primary">Español / English</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-bg-secondary border border-border rounded-xl p-5">
          <h3 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-4">¿Sobre qué?</h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {[
              'Sugerencias de artículos',
              'Errores o correcciones',
              'Colaboraciones',
              'Preguntas técnicas',
              'Publicidad o sponsors',
            ].map((item) => (
              <li class="flex items-center gap-2">
                <span class="w-1 h-1 rounded-full bg-accent-primary"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </aside>
    </div>

  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const textarea = document.getElementById('mensaje') as HTMLTextAreaElement;
  const charCount = document.getElementById('char-count')!;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;
  const errorText = document.getElementById('form-error-text')!;

  textarea?.addEventListener('input', () => {
    const count = textarea.value.length;
    charCount.textContent = String(count);
    charCount.className = count > 500 ? 'text-red-400' : '';
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nombre = (form.querySelector('#nombre') as HTMLInputElement).value.trim();
    const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
    const asunto = (form.querySelector('#asunto') as HTMLSelectElement).value;
    const mensaje = textarea.value.trim();
    const privacidad = (form.querySelector('#privacidad') as HTMLInputElement).checked;

    // Validación
    if (!nombre) return showError('El nombre es obligatorio.');
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Introduce un email válido.');
    if (!asunto) return showError('Selecciona un asunto.');
    if (!mensaje) return showError('El mensaje no puede estar vacío.');
    if (mensaje.length > 500) return showError('El mensaje no puede superar los 500 caracteres.');
    if (!privacidad) return showError('Debes aceptar la política de privacidad.');

    // Maqueta: simula envío exitoso
    hideError();
    successMsg.classList.remove('hidden');
    form.reset();
    charCount.textContent = '0';
  });

  function showError(msg: string) {
    errorText.textContent = `⚠ ${msg}`;
    errorMsg.classList.remove('hidden');
    successMsg.classList.add('hidden');
  }

  function hideError() {
    errorMsg.classList.add('hidden');
  }
</script>
