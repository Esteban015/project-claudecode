---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, getReadingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const PAGE_SIZE = 9;
  const allPosts = await getPublishedPosts();
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
        currentPage: page,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`Blog — Página ${currentPage}`}
  description={`Artículos sobre desarrollo web y tecnología. Página ${currentPage}.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-text-primary mb-2">Blog</h1>
      <p class="text-text-muted">Página {currentPage} de {totalPages}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} readingTime={getReadingTime(post.body)} />
      ))}
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/blog" />
  </div>
</BaseLayout>
