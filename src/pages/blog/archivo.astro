---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostHref } from '../../utils/posts';

const allPosts = await getPublishedPosts();

const byYear = allPosts.reduce<Record<number, typeof allPosts>>((acc, post) => {
  const year = post.data.publishedAt.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="Archivo" description="Índice cronológico de todos los artículos del blog.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold text-text-primary mb-10">Archivo</h1>

    <div class="space-y-12">
      {
        years.map((year) => (
          <section>
            <h2 class="text-2xl font-bold text-accent-primary mb-4 sticky top-20">{year}</h2>
            <ul class="space-y-3 border-l border-border pl-6">
              {byYear[year].map((post) => {
                const date = post.data.publishedAt;
                const monthDay = date.toLocaleDateString('es-ES', { month: 'short', day: 'numeric' });
                return (
                  <li class="relative">
                    <span class="absolute -left-[25px] top-2 w-3 h-3 rounded-full bg-bg-secondary border-2 border-border group-hover:border-accent-primary" />
                    <div class="flex items-baseline gap-4">
                      <time
                        datetime={date.toISOString()}
                        class="text-sm text-text-muted w-16 shrink-0"
                      >
                        {monthDay}
                      </time>
                      <a
                        href={getPostHref(post)}
                        class="text-text-primary hover:text-accent-primary transition-colors"
                      >
                        {post.data.title}
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
