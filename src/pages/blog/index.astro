---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, getReadingTime } from '../../utils/posts';

const PAGE_SIZE = 9;
const allPosts = await getPublishedPosts();
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
const posts = allPosts.slice(0, PAGE_SIZE);
---

<BaseLayout
  title="Blog"
  description="Todos los artículos sobre desarrollo web, tecnología y aprendizaje."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-text-primary mb-2">Blog</h1>
      <p class="text-text-muted">
        {allPosts.length} artículo{allPosts.length !== 1 ? 's' : ''} publicado{allPosts.length !== 1 ? 's' : ''}
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-text-muted">Todavía no hay artículos publicados.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <PostCard post={post} readingTime={getReadingTime(post.body)} />
          ))}
        </div>
      )
    }

    <Pagination currentPage={1} totalPages={totalPages} baseUrl="/blog" />
  </div>
</BaseLayout>
