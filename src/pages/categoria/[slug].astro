---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getReadingTime, getAllCategories } from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const categories = getAllCategories(allPosts);

  return categories.map(({ name }) => ({
    params: { slug: name },
    props: {
      category: name,
      posts: allPosts.filter((p) => p.data.category === name),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`Categoría: ${category}`}
  description={`Artículos en la categoría ${category}.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10">
      <p class="text-text-muted text-sm mb-2">Categoría</p>
      <h1 class="text-3xl font-bold text-text-primary">{category}</h1>
      <p class="text-text-muted mt-1">{posts.length} artículo{posts.length !== 1 ? 's' : ''}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} readingTime={getReadingTime(post.body)} />
      ))}
    </div>
  </div>
</BaseLayout>
